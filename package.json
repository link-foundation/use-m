{
  "name": "use-m",
  "version": "8.16.4",
  "description": "use-m: dynamically import any JavaScript module",
  "type": "module",
  "main": "use.cjs",
  "exports": {
    ".": {
      "import": "./use.mjs",
      "require": "./use.cjs"
    },
    "./use.cjs": "./use.cjs",
    "./use.mjs": "./use.mjs",
    "./fetch-polyfill": {
      "import": "./fetch-polyfill.js",
      "require": "./fetch-polyfill.cjs"
    },
    "./fetch-polyfill.js": {
      "import": "./fetch-polyfill.js",
      "require": "./fetch-polyfill.cjs"
    },
    "./fetch-polyfill.cjs": "./fetch-polyfill.cjs",
    "./load": {
      "import": "./src/load.mjs",
      "require": "./src/load.cjs"
    },
    "./load.cjs": "./src/load.cjs",
    "./load.mjs": "./src/load.mjs"
  },
  "bin": {
    "use": "src/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build-use-bundles.mjs",
    "prepack": "npm run build",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --disable-warning=DEP0025 --disable-warning=DEP0040 --disable-warning=DEP0125 ./node_modules/jest/bin/jest.js",
    "test:examples": "./examples/test-examples.mjs",
    "sync:entries": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/use-m.git"
  },
  "bugs": {
    "url": "https://github.com/link-foundation/use-m/issues"
  },
  "keywords": [
    "use",
    "import",
    "require",
    "npm",
    "backend",
    "frontend",
    "auto load",
    "auto install",
    "cache",
    "global require",
    "global import",
    "dynamic require",
    "dynamic import",
    "package loader",
    "module loader",
    "dependency management",
    "zx",
    "execa",
    "esm.sh",
    "esm",
    "unpkg.com",
    "unpkg"
  ],
  "author": "link-foundation",
  "license": "Unlicense",
  "files": [
    "use.mjs",
    "use.cjs",
    "use.js",
    "fetch-polyfill.js",
    "fetch-polyfill.cjs",
    "src/use.mjs",
    "src/use.cjs",
    "src/use.js",
    "src/use",
    "src/fetch-polyfill.mjs",
    "src/fetch-polyfill.cjs",
    "src/cli.mjs",
    "src/loader.js",
    "src/load.mjs",
    "src/load.cjs",
    "src/test-adapter.mjs",
    "src/test-adapter.cjs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^29.7.0",
    "browser-commander": "^0.8.1",
    "command-stream": "^0.0.5",
    "esbuild": "^0.25.12",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "puppeteer": "^24.16.2"
  },
  "dependencies": {
    "undici": "^6.28.1"
  },
  "allowScripts": {
    "esbuild": true,
    "puppeteer": true
  }
}
